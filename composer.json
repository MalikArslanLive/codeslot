{
  "name": "codeslot/codeslot",
  "description": "Privileged WordPress code management",
  "license": "GPL-2.0-or-later",
  "require": {"php": ">=7.4"},
  "require-dev": {
    "phpunit/phpunit": "9.6.33",
    "squizlabs/php_codesniffer": "3.13.6",
    "wp-coding-standards/wpcs": "3.4.1",
    "phpstan/phpstan": "2.1.17",
    "php-stubs/wordpress-stubs": "6.8.2",
    "dealerdirect/phpcodesniffer-composer-installer": "1.1.2"
  },
  "config": {"allow-plugins": {"dealerdirect/phpcodesniffer-composer-installer": true}},
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "analyse": "phpstan analyse --memory-limit=2G"
  }
}
